// site/keys: keyboard shortcuts, in the style of rex.bind.
//
// A key is modifiers and a key joined by "+" ("shift+g", "?", "g>w").
// A sequence is keys joined by ">" ("g>w"). A key in a mode is written
// "mode/key" ("nav/j") and only works while that mode is active; Escape
// leaves a mode. Bindings name an action: a script action or a built-in one.
// Keys never fire while the visitor is typing in a field.

pub fn bind(key: string, action: string) -> void
pub fn unbind(key: string) -> void
pub fn mode(name: string, exclusive: bool) -> void   // declare a mode's options
pub fn enter(mode: string) -> void
pub fn exit() -> void
