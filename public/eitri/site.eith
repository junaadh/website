// site: the page this script is running on.
//
// A run starts from the default page and applies every call when the script
// finishes, so a script describes the whole customisation. Changes are local
// to this visitor. The console saves a script that runs cleanly and replays
// it on the next visit.

pub enum Weather {
    Clear
    Rain
    Storm
    Static
    Aurora
}

pub enum Status {
    Active
    Shipped
    Experiment
    Archived
}

pub struct Project {
    pub slug: string
    pub name: string
    pub kind: string
    pub year: i64
    pub status: Status
    pub featured: bool
    pub stack: []string
}

pub struct Time {
    pub hour: i64       // 0-23, Maldives time (UTC+5)
    pub minute: i64
    pub weekday: i64    // 0 is Sunday
}

// What the page knows.
pub let projects: []Project
pub let time: Time
pub let visits: i64     // saved-script runs in this browser, this one included

// Look up one project by slug.
pub fn find(slug: string) -> ?Project {
    for p in projects {
        if p.slug == slug {
            return p
        }
    }
    return null
}

// Look.
pub fn hue(degrees: i64) -> void            // accent colour, 0-359
pub fn weather(kind: Weather) -> void
pub fn grid(size: i64) -> void              // backdrop grid cell in px, 0 hides it
pub fn scanlines(on: bool) -> void
pub fn glow(level: i64) -> void             // 0-100
pub fn mono(on: bool) -> void               // set the whole page in the mono face

// Content.
pub fn title(text: string) -> void          // the large name in the hero
pub fn order(slugs: []string) -> void       // project order, unlisted ones follow
pub fn hide(slug: string) -> void
pub fn highlight(slug: string) -> void
pub fn open(slug: string) -> void           // go to a project when the run ends

// Console.
pub fn print(text: string) -> void
pub fn toast(text: string) -> void
